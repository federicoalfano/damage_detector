DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite3
API_KEY=
# Vision provider. Validated setup = OpenRouter + gemini-2.5-flash-lite
# (cheapest + best critical-damage recall in benchmark_models.py).
# NOTE: do NOT use gpt-4o-mini for vision — it bills 5,667 tokens/512px-tile
# (~150x flash-lite per image). The config default (o4-mini) is a reasoning
# model; always set OPENAI_MODEL explicitly in deploys.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.5-flash-lite
# Independent VLM passes per photo, merged union-wise (recall-first) with
# agreement->confidence. 1 = single pass; 3 = recommended for critical recall.
VLM_PASSES=3
# Independent runs of the scudo tiled detail pass, unioned (recall-first). The
# tile pass is the source of critical-damage recall and is highly nondeterministic,
# so 1 run randomly misses real damage. 2 = recommended. Only affects scudo.
TILE_PASSES=2
DATA_DIR=./data
